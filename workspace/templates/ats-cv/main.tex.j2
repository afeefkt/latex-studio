\BLOCK{ for edu in facts.education }
\textbf{\VAR{ edu.degree | tex_escape }} -- \VAR{ edu.institution | tex_escape }\BLOCK{ if edu.location }, \VAR{ edu.location | tex_escape }\BLOCK{ endif } \hfill \VAR{ edu.years | tex_escape }
\BLOCK{ if edu.focus }
\par\small \VAR{ edu.focus | tex_escape }
\BLOCK{ endif }
